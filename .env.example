GREEN500_DATABASE_URL=postgresql://green500_app:replace-password@127.0.0.1:5432/green500
GREEN500_DATA_DIR=/srv/green500/data
GREEN500_LLM_BASE_URL=https://api.openai.com/v1
GREEN500_LLM_API_KEY=
GREEN500_LLM_MODEL=gpt-4.1-mini
GREEN500_OPS_TOKEN=replace-with-a-random-token
GREEN500_MAX_SOURCE_CHARACTERS=1000000
# Zero permits originals of any size; text parsing has separate controls.
GREEN500_MAX_DOCUMENT_BYTES=0
GREEN500_VIEW_PASSWORD=replace-with-a-viewer-password
GREEN500_MAX_MODEL_CALLS=16

# Optional compatibility variables for the earlier root-level analysis scripts.
OPENAI_API_KEY=
OPENAI_MODEL=
