      "id": 3923,
      "company_cik": "0001559720",
      "title": "Airbnb Sustainability and Community Update",
      "url": "https://airbnb2020ipo.q4web.com/files/doc_downloads/governance_doc_updated/2023/Airbnb-SustainabilityandCommunityUpdate-2023-111623.pdf",
      "categories": [
        "environment_report",
        "social_employee",
        "climate_targets"
      ],
      "reporting_period": "Update published 2023-11-20; environmental and workforce performance mainly through 2022",
      "discovered_via": "agent",
      "evidence": [
        {
          "page": 2,
          "brief": "Airbnb defines the update as covering greenhouse-gas reduction and initiatives intended to help employees from varied backgrounds succeed and thrive."
        },
        {
          "page": 5,
          "brief": "Airbnb states its net-zero-by-2030 goal and identifies the included Scope 1, Scope 2, and Scope 3 corporate operations."
        },
        {
          "page": 10,
          "brief": "The report gives distinct 2030 Scope 1 and 2 absolute-emissions and Scope 3 emissions-intensity targets from a 2019 baseline."
        },
        {
          "page": 23,
          "brief": "The Supporting our Employees section covers flexible work and the annual employee-engagement survey."
        },
        {
          "page": 24,
          "brief": "Airbnb describes annual pay-equity analysis, learning and development, and performance feedback practices."
        },
        {
          "page": 25,
          "brief": "The report lists employee compensation, flexibility, health, wellbeing, insurance, and mental-health benefits, subject to eligibility and regional variation."
        }
      ],
      "document_id": 2344,
      "sha256": "087cf27af5a5c13262961da728c094a4e1027c85f4e3dce5183880f84251e5ad",
